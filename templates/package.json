{
  "name": "@zerobias-org/qualification-{issuer}-{code}",
  "version": "1.0.0",
  "description": "{name} qualification artifact",
  "author": "team@zerobias.com",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/qualification.git",
    "directory": "package/{issuer}/{code}/"
  },
  "scripts": {
    "correct:deps": "tsx ../../../scripts/correctDeps.ts"
  },
  "publishConfig": {
    "registry": "https://pkg.zerobias.org"
  },
  "files": [
    "index.yml",
    "logo.*",
    "npm-shrinkwrap.json"
  ],
  "zerobias": {
    "dataloader-version": "3.29.26",
    "import-artifact": "qualification",
    "package": "{issuer}.{code}.qualification"
  },
  "dependencies": {
    "@zerobias-org/vendor-{issuer}": "*"
  }
}
